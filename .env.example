# Local development: copy to `.env` (gitignored).
# Cloud Run: map Secret Manager secrets to the same names (`GEMINI_API_KEY`, `MODERATOR_EMAIL`).
# Do not COPY this file or a service-account JSON into a Docker image.
# Deploy steps: specs/runbooks/cloud-run.md

GEMINI_API_KEY=
MODERATOR_EMAIL=

# Public Firebase web config (served by GET /api/config; not secret).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=

# Resource caps (ordinary env, not secret). Positive integers; otherwise these defaults.
# Profiles, owned budgets, and each income/expense category list and entry list.
CAP_USER_COUNT=3
CAP_USER_BUDGET_COUNT=2
CAP_CATEGORY_COUNT=4
CAP_ENTRY_COUNT=4

# Local Firebase emulators (Auth + Firestore). Point Admin SDK here; rules deny all client access.
# GET /api/config includes authEmulatorHost so the browser Auth SDK uses the emulator too.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
